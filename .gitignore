# Agent worktrees — scratch clones, never part of the repo
.claude/worktrees/

# OS cruft
.DS_Store

# Build + deps
node_modules/
dist/
*.local
# Vite's dep-optimiser cache, written next to the config when the dev server
# runs from the repo root.
.vite/

# The native projects (ios/, android/) ship their own .gitignore, generated by
# `cap add` — they already exclude the copied web assets and build output.

# ASO learning workspace (personal notes, not app code)
aso-learning/

# Raw art packs pulled down for review — source material, not shipped assets.
# Individual sheets get composed into src/**/assets/ when a ticket selects them.
docs/raw_assets/

.vscode/
